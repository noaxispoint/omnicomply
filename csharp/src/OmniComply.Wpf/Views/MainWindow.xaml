<Window x:Class="OmniComply.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OmniComply.Wpf.ViewModels"
        xmlns:conv="clr-namespace:OmniComply.Wpf.Converters"
        Title="OmniComply - Multi-Framework Compliance Validator"
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToPassFailConverter x:Key="PassFailConverter"/>
        <conv:BoolToColorConverter x:Key="ColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="OmniComply" Style="{StaticResource HeaderText}"/>
                    <TextBlock Foreground="#CCDDEE" FontSize="12">
                        <Run Text="Computer: "/><Run Text="{Binding ComputerName, Mode=OneWay}"/>
                        <Run Text=" | "/><Run Text="{Binding WindowsVersion, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="Frameworks: SOC 2, HIPAA, NIST 800-53, CIS v8, ISO 27001, PCI-DSS, SOX, GDPR, CCPA"
                               Foreground="#AABBCC" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Run Scan" Command="{Binding RunScanCommand}" Style="{StaticResource ActionButton}"
                            Margin="5,0" Background="#005A9E"/>
                    <Button Content="Export Reports" Command="{Binding ExportReportsCommand}" Style="{StaticResource ActionButton}"
                            Margin="5,0" Background="#107C10"/>
                    <Button Content="Remediate" Command="{Binding RunRemediationCommand}" Style="{StaticResource ActionButton}"
                            Margin="5,0" Background="#D13438"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Progress Bar -->
        <StackPanel Grid.Row="1" Margin="20,10" Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ProgressBar Height="20" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}"/>
        </StackPanel>

        <!-- Summary Stats -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="15,5"
                    Visibility="{Binding HasScanResults, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource StatBox}">
                <StackPanel>
                    <TextBlock Text="Total Checks" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock Text="{Binding TotalChecks}" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatBox}">
                <StackPanel>
                    <TextBlock Text="Passed" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource PassBrush}"/>
                    <TextBlock FontSize="24" FontWeight="Bold" Foreground="{StaticResource PassBrush}">
                        <Run Text="{Binding PassedChecks_, Mode=OneWay}"/>
                        <Run Text=" ("/>
                        <Run Text="{Binding PassPercentage, Mode=OneWay, StringFormat='{}{0}%'}"/>
                        <Run Text=")"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatBox}">
                <StackPanel>
                    <TextBlock Text="Failed" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource FailBrush}"/>
                    <TextBlock Text="{Binding FailedChecks_}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource FailBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource StatBox}">
                <StackPanel>
                    <TextBlock Text="Status" FontWeight="SemiBold" FontSize="11"/>
                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="{Binding IsCompliant, Converter={StaticResource ColorConverter}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="NON-COMPLIANT"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompliant}" Value="True">
                                        <Setter Property="Text" Value="COMPLIANT"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Content: Tabbed View -->
        <TabControl Grid.Row="3" Margin="15,5">
            <!-- All Checks Tab -->
            <TabItem Header="All Checks">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="Framework:" VerticalAlignment="Center" Margin="5,0"/>
                        <ComboBox ItemsSource="{Binding FrameworkFilters}" SelectedItem="{Binding SelectedFrameworkFilter}"
                                  Width="150" Margin="5,0"/>
                        <TextBlock Text="Category:" VerticalAlignment="Center" Margin="15,0,5,0"/>
                        <ComboBox ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding SelectedCategoryFilter}"
                                  Width="250" Margin="5,0"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Checks}" SelectedItem="{Binding SelectedCheck}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                              GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Status" Binding="{Binding Passed, Converter={StaticResource PassFailConverter}}" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Passed, Converter={StaticResource ColorConverter}}"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/>
                            <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="250"/>
                            <DataGridTextColumn Header="Current Value" Binding="{Binding CurrentValue}" Width="200"/>
                            <DataGridTextColumn Header="Expected Value" Binding="{Binding ExpectedValue}" Width="200"/>
                            <DataGridTextColumn Header="Requirement" Binding="{Binding Requirement}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- Failed Checks Tab -->
            <TabItem Header="Failed Checks">
                <DataGrid ItemsSource="{Binding FailedChecks}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="#FFF4F4">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="180"/>
                        <DataGridTextColumn Header="Check" Binding="{Binding Check}" Width="250"/>
                        <DataGridTextColumn Header="Current" Binding="{Binding CurrentValue}" Width="200"/>
                        <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedValue}" Width="200"/>
                        <DataGridTextColumn Header="Remediation" Binding="{Binding Remediation}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Category Breakdown Tab -->
            <TabItem Header="Category Breakdown">
                <DataGrid ItemsSource="{Binding CategorySummaries}" AutoGenerateColumns="False" IsReadOnly="True"
                          GridLinesVisibility="Horizontal" AlternatingRowBackground="#F8F8F8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                        <DataGridTextColumn Header="Passed" Binding="{Binding Passed}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource PassBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Failed" Binding="{Binding Failed}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource FailBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="80"/>
                        <DataGridTextColumn Header="Pass %" Binding="{Binding PassPercentage, StringFormat='{}{0}%'}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <!-- Check Detail Tab -->
            <TabItem Header="Check Detail">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <StackPanel DataContext="{Binding SelectedCheck}">
                        <TextBlock Text="Select a check from the 'All Checks' tab to view details"
                                   FontStyle="Italic" Foreground="Gray" Margin="0,0,0,10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding Check}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                        <TextBlock Text="{Binding Category}" FontSize="12" Foreground="Gray" Margin="0,0,0,15"/>

                        <TextBlock Text="Status" Style="{StaticResource SubHeaderText}"/>
                        <TextBlock Text="{Binding Passed, Converter={StaticResource PassFailConverter}}"
                                   Foreground="{Binding Passed, Converter={StaticResource ColorConverter}}"
                                   FontWeight="Bold" FontSize="16"/>

                        <TextBlock Text="Requirement" Style="{StaticResource SubHeaderText}"/>
                        <TextBlock Text="{Binding Requirement}" TextWrapping="Wrap"/>

                        <TextBlock Text="Current Value" Style="{StaticResource SubHeaderText}"/>
                        <TextBlock Text="{Binding CurrentValue}" TextWrapping="Wrap"/>

                        <TextBlock Text="Expected Value" Style="{StaticResource SubHeaderText}"/>
                        <TextBlock Text="{Binding ExpectedValue}" TextWrapping="Wrap"/>

                        <TextBlock Text="Remediation" Style="{StaticResource SubHeaderText}"/>
                        <TextBox Text="{Binding Remediation, Mode=OneWay}" IsReadOnly="True"
                                 TextWrapping="Wrap" Background="#F0F0F0" Padding="10" Margin="0,0,0,10"
                                 FontFamily="Consolas" BorderThickness="1" BorderBrush="#DDD"/>

                        <TextBlock Text="Intune Recommendation" Style="{StaticResource SubHeaderText}"/>
                        <TextBlock Text="{Binding IntuneRecommendation}" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="4" Background="#333" Padding="10,5">
            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11"/>
        </Border>
    </Grid>
</Window>
